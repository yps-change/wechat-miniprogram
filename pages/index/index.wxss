/* ========== 页面背景 ========== */
.page-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFE8D6 40%, #FFDAB9 100%);
  position: relative;
  overflow: hidden;
}

.page-bg::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(255,107,53,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.page-bg::after {
  content: '';
  position: absolute;
  bottom: -150rpx;
  left: -150rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,105,180,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 粒子画布 */
.particle-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  pointer-events: none;
}

/* ========== 顶部标题 ========== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-emoji {
  font-size: 48rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B35, #FF1493);
  -webkit-background-clip: text;
  color: transparent;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ========== 转盘区域 ========== */
.wheel-area {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-canvas {
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  box-shadow:
    0 0 0 8rpx #FF6B35,
    0 0 0 14rpx #FFF8F0,
    0 0 0 20rpx rgba(255,107,53,0.3),
    0 8rpx 40rpx rgba(255,107,53,0.25);
}

/* 指针 */
.pointer {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pointer-arrow {
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-top: 40rpx solid #FF6B35;
  filter: drop-shadow(0 4rpx 8rpx rgba(255,107,53,0.4));
}

.pointer-dot {
  width: 16rpx;
  height: 16rpx;
  background: #FF6B35;
  border-radius: 50%;
  margin-top: -6rpx;
}

/* 外圈装饰灯 */
.wheel-lights {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
}

.light-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: -7rpx 0 0 -7rpx;
  transition: all 0.3s ease;
}

.light-dot.on {
  background: #FFD700;
  box-shadow: 0 0 10rpx 4rpx rgba(255,215,0,0.6);
}

.light-dot.off {
  background: rgba(255,215,0,0.25);
  box-shadow: none;
}

/* ========== 结果弹窗 ========== */
.result-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  background: rgba(0,0,0,0.55);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.result-popup.show {
  opacity: 1;
  pointer-events: auto;
}

.result-card {
  position: relative;
  width: 520rpx;
  padding: 60rpx 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  transform: scale(0.6);
  transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  overflow: hidden;
}

.result-popup.show .result-card {
  transform: scale(1);
}

.result-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(255,107,53,0.08) 60deg,
    transparent 120deg,
    rgba(255,105,180,0.08) 180deg,
    transparent 240deg,
    rgba(123,104,238,0.08) 300deg,
    transparent 360deg
  );
  animation: spin-glow 4s linear infinite;
}

@keyframes spin-glow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.result-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
  animation: pop-in 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.3s both;
}

@keyframes pop-in {
  0% { transform: scale(0) rotate(-30deg); opacity: 0; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.result-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.result-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.result-category {
  font-size: 26rpx;
  color: #666;
  background: #FFF0EB;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.result-price {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: 600;
}

.result-tags {
  display: flex;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.tag {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

/* ========== 操作按钮 ========== */
.action-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

.spin-btn {
  min-width: 420rpx;
  padding: 32rpx 80rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #FFFFFF;
  border: none;
  border-radius: 60rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 30rpx rgba(255,107,53,0.4);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.spin-btn::after {
  border: none;
}

.spin-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255,255,255,0.15) 50%,
    transparent 70%
  );
  animation: btn-shine 3s ease-in-out infinite;
}

@keyframes btn-shine {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.spin-btn.spinning {
  background: linear-gradient(135deg, #ccc, #aaa);
  box-shadow: none;
}

.spin-btn-text {
  position: relative;
  z-index: 1;
}

.secondary-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
  animation: fade-up 0.4s ease;
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.btn-confirm {
  background: linear-gradient(135deg, #FF1493, #FF69B4);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255,20,147,0.3);
}

.btn-confirm::after { border: none; }

.btn-candidates {
  background: linear-gradient(135deg, #7B68EE, #9370DB);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(123,104,238,0.3);
}

.btn-candidates::after { border: none; }

/* 分享按钮 */
.share-area {
  margin-top: 30rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  animation: fade-up 0.5s ease 0.2s both;
}

.share-btn {
  background: transparent;
  color: #FF6B35;
  font-size: 28rpx;
  border: 2rpx solid #FF6B35;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  line-height: 1.4;
}

.share-btn::after { border: none; }

/* 连击提示 */
.combo-hint {
  position: fixed;
  top: 120rpx;
  right: 30rpx;
  z-index: 200;
  animation: combo-pop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes combo-pop {
  0% { transform: scale(0) rotate(-15deg); }
  60% { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.combo-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
  background: rgba(255,255,255,0.95);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,53,0.2);
}
