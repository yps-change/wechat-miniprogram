/* ========== 页面背景 ========== */
.page-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #F0F5FF 50%, #E0EBFF 100%);
  position: relative;
  overflow: hidden;
}

.page-bg::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(74,123,247,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.page-bg::after {
  content: '';
  position: absolute;
  bottom: -150rpx;
  left: -150rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(108,155,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 70rpx 30rpx 150rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 粒子画布 */
.particle-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1200;
  pointer-events: none;
}

/* ========== 顶部标题 ========== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-emoji {
  font-size: 48rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  color: #2D5BE3;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ========== 转盘区域 ========== */
.wheel-area {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-canvas {
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  box-shadow:
    0 0 0 8rpx #4A7BF7,
    0 0 0 14rpx #F0F5FF,
    0 0 0 20rpx rgba(74,123,247,0.3),
    0 8rpx 40rpx rgba(74,123,247,0.2);
}

/* 指针 */
.pointer {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pointer-arrow {
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-top: 40rpx solid #4A7BF7;
  filter: drop-shadow(0 4rpx 8rpx rgba(74,123,247,0.4));
}

.pointer-dot {
  width: 16rpx;
  height: 16rpx;
  background: #4A7BF7;
  border-radius: 50%;
  margin-top: -6rpx;
}

/* 外圈装饰灯 */
.wheel-lights {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
}

.light-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: -7rpx 0 0 -7rpx;
  transition: all 0.3s ease;
}

.light-dot.on {
  background: #FFD700;
  box-shadow: 0 0 10rpx 4rpx rgba(255,215,0,0.6);
}

.light-dot.off {
  background: rgba(255,215,0,0.25);
  box-shadow: none;
}

/* ========== 结果弹窗 ========== */
.result-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  background: rgba(0,0,0,0.55);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
}

.result-popup.show {
  opacity: 1;
  pointer-events: auto;
}

.result-card {
  position: relative;
  width: 520rpx;
  padding: 60rpx 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15), 0 0 0 8rpx rgba(77,150,255,0.16);
  transform: scale(0.4) rotateY(540deg) rotateZ(-12deg);
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.7s ease;
  overflow: visible;
}

.result-card::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 760rpx;
  height: 760rpx;
  transform: translate(-50%, -50%) scale(0.25) rotate(0deg);
  border-radius: 50%;
  background: repeating-conic-gradient(
    from 0deg,
    rgba(74,123,247,0.86) 0deg 3deg,
    transparent 3deg 17deg,
    rgba(255,105,180,0.72) 17deg 20deg,
    transparent 20deg 34deg
  );
  opacity: 0;
  z-index: -1;
  pointer-events: none;
}

.result-card::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 620rpx;
  height: 620rpx;
  transform: translate(-50%, -50%) scale(0.08);
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255,255,255,0.98) 0 4%, transparent 5%),
    repeating-conic-gradient(
      from 8deg,
      #FF4D6D 0deg 2deg,
      transparent 2deg 16deg,
      #8B7CFF 16deg 19deg,
      transparent 19deg 34deg,
      #4D96FF 34deg 37deg,
      transparent 37deg 52deg
    );
  filter: drop-shadow(0 0 18rpx rgba(77,150,255,0.72));
  opacity: 0;
  z-index: -1;
  pointer-events: none;
}

.result-popup.show .result-card {
  transform: scale(1) rotateY(0deg) rotateZ(0deg);
  animation: card-reveal 0.85s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

.result-popup.show .result-card::before {
  animation: burst-rays 1.15s cubic-bezier(0.16, 0.9, 0.24, 1) 0.02s both;
}

.result-popup.show .result-card::after {
  animation: burst-flash 0.9s cubic-bezier(0.16, 0.9, 0.24, 1) 0.1s both;
}

.result-popup.absorbing {
  background: rgba(0,0,0,0.28);
}

.result-popup.absorbing .result-card {
  animation: shoot-to-history 0.78s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes card-reveal {
  0% { transform: scale(0.18) rotateY(720deg) rotateZ(-28deg); opacity: 0; }
  55% { transform: scale(1.16) rotateY(-34deg) rotateZ(7deg); opacity: 1; }
  78% { transform: scale(0.96) rotateY(12deg) rotateZ(-3deg); opacity: 1; }
  100% { transform: scale(1) rotateY(0deg) rotateZ(0deg); opacity: 1; }
}

@keyframes burst-rays {
  0% { transform: translate(-50%, -50%) scale(0.05) rotate(-25deg); opacity: 0; }
  28% { opacity: 1; }
  62% { transform: translate(-50%, -50%) scale(1.18) rotate(12deg); opacity: 0.85; }
  100% { transform: translate(-50%, -50%) scale(1.42) rotate(28deg); opacity: 0; }
}

@keyframes burst-flash {
  0% { transform: translate(-50%, -50%) scale(0.08) rotate(-18deg); opacity: 0; }
  18% { transform: translate(-50%, -50%) scale(0.35) rotate(0deg); opacity: 1; }
  42% { transform: translate(-50%, -50%) scale(0.92) rotate(18deg); opacity: 0.95; }
  100% { transform: translate(-50%, -50%) scale(1.42) rotate(36deg); opacity: 0; }
}

@keyframes shoot-to-history {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 1; }
  35% { transform: translate(70rpx, -170rpx) scale(0.76) rotate(18deg); opacity: 1; }
  68% { transform: translate(170rpx, 120rpx) scale(0.45) rotate(38deg); opacity: 0.95; }
  88% { transform: translate(230rpx, 390rpx) scale(0.26) rotate(58deg); opacity: 0.8; }
  100% { transform: translate(255rpx, 610rpx) scale(0.1) rotate(76deg); opacity: 0; }
}

.result-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(74,123,247,0.08) 60deg,
    transparent 120deg,
    rgba(255,105,180,0.08) 180deg,
    transparent 240deg,
    rgba(123,104,238,0.08) 300deg,
    transparent 360deg
  );
  animation: spin-glow 4s linear infinite;
}

@keyframes spin-glow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.result-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
  animation: pop-in 0.78s cubic-bezier(0.16, 1.2, 0.3, 1) 0.26s both;
}

@keyframes pop-in {
  0% { transform: scale(0) rotate(-30deg); opacity: 0; }
  52% { transform: scale(1.28) rotate(10deg); opacity: 1; }
  72% { transform: scale(0.9) rotate(-5deg); }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.result-name {
  font-size: 52rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.result-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.result-category {
  font-size: 28rpx;
  color: #555;
  background: #EBF0FF;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.result-price {
  font-size: 30rpx;
  color: #4A7BF7;
  font-weight: 600;
}

.result-tags {
  display: flex;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.result-draw-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8A8A8A;
  position: relative;
  z-index: 1;
}

.tag {
  font-size: 26rpx;
  color: #555;
  background: #f0f0f0;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

/* 投篮落点：与微信底部原生历史 Tab 的右侧位置对齐 */
.history-target {
  position: fixed;
  right: 46rpx;
  bottom: 82rpx;
  z-index: 1150;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 16rpx;
  background: rgba(255,255,255,0.98);
  border: 2rpx solid rgba(74,123,247,0.22);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,123,247,0.22);
  opacity: 0;
  transform: translateY(30rpx) scale(0.75);
  pointer-events: none;
}

.history-target.catching {
  opacity: 1;
  animation: history-receive 0.9s ease both;
}

.history-target.received {
  opacity: 1;
  animation: history-received 0.7s ease both;
}

.history-target-icon {
  font-size: 40rpx;
  line-height: 1;
}

.history-target-text {
  margin-top: 4rpx;
  color: #4A7BF7;
  font-size: 20rpx;
  font-weight: 700;
}

@keyframes history-received {
  0% { transform: translateY(0) scale(1) rotate(0deg); }
  25% { transform: translateY(0) scale(1.18) rotate(-8deg); }
  50% { transform: translateY(0) scale(1.18) rotate(8deg); }
  75% { transform: translateY(0) scale(1.08) rotate(-4deg); }
  100% { transform: translateY(0) scale(1) rotate(0deg); }
}

@keyframes history-receive {
  0% { transform: translateY(30rpx) scale(0.75) rotate(0deg); }
  18% { transform: translateY(0) scale(1.12) rotate(-7deg); }
  34% { transform: translateY(0) scale(1.12) rotate(7deg); }
  52% { transform: translateY(0) scale(1.05) rotate(-5deg); }
  70% { transform: translateY(0) scale(1.04) rotate(4deg); }
  100% { transform: translateY(0) scale(1) rotate(0deg); }
}

/* ========== 操作按钮（首页） ========== */
.action-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

/* 双按钮布局 */
.dual-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
  justify-content: center;
}

.quick-btn {
  flex: 1;
  max-width: 340rpx;
  height: 112rpx;
  line-height: 112rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  color: #4A7BF7;
  border: 3rpx solid #4A7BF7;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,123,247,0.15);
}

.quick-btn::after { border: none; }

.quick-btn-icon {
  font-size: 34rpx;
  line-height: 1;
  flex-shrink: 0;
}

.quick-btn-text {
  font-size: 34rpx;
  line-height: 1;
  white-space: nowrap;
}

.spin-btn {
  flex: 1;
  max-width: 340rpx;
  height: 112rpx;
  line-height: 112rpx;
  padding: 0 18rpx;
  background: linear-gradient(135deg, #4A7BF7, #6C9BFF);
  color: #FFFFFF;
  border: none;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 30rpx rgba(74,123,247,0.35);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.spin-btn::after {
  border: none;
}

.spin-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255,255,255,0.15) 50%,
    transparent 70%
  );
  animation: btn-shine 3s ease-in-out infinite;
}

@keyframes btn-shine {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.spin-btn.spinning {
  background: linear-gradient(135deg, #ccc, #aaa);
  box-shadow: none;
}

.spin-btn-text {
  position: relative;
  z-index: 1;
  display: block;
  line-height: 112rpx;
  white-space: nowrap;
}

.coupon-entry-btn {
  width: 360rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  background: #FFF3E0;
  color: #E67E22;
  border: 2rpx solid rgba(230,126,34,0.2);
  border-radius: 36rpx;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(230,126,34,0.14);
}

.coupon-entry-btn::after {
  border: none;
}

/* ========== 弹窗内操作按钮 ========== */
.popup-actions {
  width: 100%;
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.popup-btn-confirm {
  width: 100%;
  padding: 26rpx 0;
  background: linear-gradient(135deg, #4A7BF7, #6C9BFF);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(74,123,247,0.3);
}
.popup-btn-confirm::after { border: none; }

.popup-sub-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.popup-btn-again {
  flex: 1;
  padding: 20rpx 0;
  background: #EBF0FF;
  color: #4A7BF7;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.popup-btn-again::after { border: none; }

.popup-btn-candidates {
  flex: 1;
  padding: 20rpx 0;
  background: #F0F0F0;
  color: #555;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.popup-btn-candidates::after { border: none; }

.popup-btn-share {
  background: transparent;
  color: #999;
  font-size: 24rpx;
  border: none;
  padding: 12rpx 0;
}
.popup-btn-share::after { border: none; }

/* 连击提示 */
.combo-hint {
  position: fixed;
  top: 120rpx;
  right: 30rpx;
  z-index: 200;
  animation: combo-pop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes combo-pop {
  0% { transform: scale(0) rotate(-15deg); }
  60% { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.combo-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A7BF7;
  background: rgba(255,255,255,0.95);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,123,247,0.2);
}
