.home-page { height: 100vh; min-height: 0; display: flex; flex-direction: column; padding: 18rpx 32rpx calc(128rpx + env(safe-area-inset-bottom)); background: var(--bg-color); }
.header { position: relative; flex-shrink: 0; margin-bottom: 12rpx; }
.home-eyebrow { display: block; font-size: 16rpx; line-height: 1.4; letter-spacing: 3rpx; color: var(--sage-color); margin-bottom: 8rpx; }
.title { display: block; font-size: 46rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1.35; white-space: nowrap; }
.title-accent { color: var(--primary-color); }
.subtitle { display: block; font-size: 23rpx; line-height: 1.5; color: var(--text-secondary); margin-top: 6rpx; }
.header-spark { position: absolute; top: 0; right: 8rpx; width: 34rpx; height: 34rpx; transform: rotate(12deg); }
.section-head { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12rpx; height: 44rpx; }
.section-label { font-size: 20rpx; color: var(--sage-color); letter-spacing: 2rpx; white-space: nowrap; }
.section-label::before { content: ''; display: inline-block; width: 9rpx; height: 9rpx; background: #879571; border-radius: 50%; margin-right: 10rpx; vertical-align: middle; }
.pool-badge.pool-badge { display: flex; align-items: center; gap: 12rpx; width: auto; min-width: 0; margin: 0; height: 44rpx; padding: 6rpx 16rpx; border: 1rpx solid #DDDCC8; border-radius: 24rpx; background: #FFFDF7B3; color: var(--text-color); font-size: 20rpx; line-height: 1.5; }
.pool-arrow { font-size: 27rpx; line-height: 1; }
.wheel-stage { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
.wheel-area { position: relative; flex-shrink: 0; width: calc(100vh - 686rpx - env(safe-area-inset-bottom)); height: calc(100vh - 686rpx - env(safe-area-inset-bottom)); max-width: 580rpx; max-height: 580rpx; }
.plate-rim { position: absolute; inset: 0; border-radius: 50%; box-shadow: 0 12rpx 32rpx rgba(109, 102, 65, .09); }
.wheel-canvas { position: absolute; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; border-radius: 50%; }
.plate-note { position: absolute; right: -20rpx; bottom: 4rpx; display: flex; align-items: center; gap: 6rpx; padding: 8rpx 12rpx; background: #E0E8C9; border-radius: 8rpx; color: var(--sage-color); font-size: 18rpx; line-height: 1.4; transform: rotate(-7deg); }
.plate-note image { width: 20rpx; height: 20rpx; }
.wheel-leaf { position: absolute; left: -30rpx; top: 22%; width: 23rpx; height: 43rpx; border-radius: 2rpx 90% 2rpx 90%; background: #9DAC7C; transform: rotate(-28deg); }
.wheel-dot { position: absolute; right: -23rpx; top: 28%; width: 15rpx; height: 15rpx; border-radius: 50%; background: #DCA66D; }
.action-area { flex-shrink: 0; width: 100%; margin-bottom: 64rpx; }
.spin-btn.spin-btn { display: flex; justify-content: center; align-items: center; gap: 18rpx; width: 100%; min-height: 80rpx; height: 80rpx; padding: 16rpx 20rpx; margin: 0; font-size: 28rpx; letter-spacing: 1rpx; border-radius: 22rpx; }
.quick-btn.quick-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; height: 58rpx; padding: 12rpx 0; margin: 0; background: transparent; color: var(--text-secondary); font-size: 23rpx; line-height: 1.4; }
.quick-highlight { color: var(--primary-color); }
.home-coupon.home-coupon { position: relative; display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 108rpx; height: 108rpx; margin: 0; padding: 14rpx 20rpx; border: 1rpx solid #C8D2BB; border-radius: 20rpx; background: #E5EBDB; box-shadow: 0 4rpx 10rpx rgba(83, 105, 77, .06); }
.home-coupon .coupon-entry-icon { width: 58rpx; height: 58rpx; padding: 8rpx; box-sizing: border-box; background: var(--card-bg); border-radius: 14rpx; }
.home-coupon .coupon-entry-title { font-size: 28rpx; font-weight: 750; color: var(--text-color); }
.home-coupon .coupon-entry-hint { margin-top: 3rpx; font-size: 20rpx; color: var(--sage-color); }
.home-coupon .coupon-entry-more { border: 0; border-radius: 14rpx; padding: 10rpx 18rpx; background: var(--primary-color); color: #FFF9EE; font-size: 24rpx; font-weight: 700; }
.home-coupon.button-hover { background: #DCE5CF; }
@media (max-height: 540px) {
  .home-page { padding-top: 10rpx; }
  .home-eyebrow { font-size: 14rpx; margin-bottom: 4rpx; }
  .title { font-size: 42rpx; }
  .subtitle { font-size: 21rpx; margin-top: 4rpx; }
  .header { margin-bottom: 8rpx; }
  .wheel-area { width: calc(100vh - 600rpx - env(safe-area-inset-bottom)); height: calc(100vh - 600rpx - env(safe-area-inset-bottom)); }
  .action-area { margin-bottom: 20rpx; }
  .plate-note { font-size: 16rpx; }
}
