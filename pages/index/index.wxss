/* ========== 页面背景 ========== */
.page-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #F0F5FF 50%, #E0EBFF 100%);
  position: relative;
  overflow: hidden;
}

.page-bg::before {
  content: '';
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(74,123,247,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.page-bg::after {
  content: '';
  position: absolute;
  bottom: -150rpx;
  left: -150rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(108,155,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 70rpx 30rpx 150rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 粒子画布 */
.particle-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1200;
  pointer-events: none;
}

/* ========== 顶部标题 ========== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-emoji {
  font-size: 48rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  color: #2D5BE3;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.pool-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  background: rgba(74, 123, 247, 0.1);
  border: 1rpx solid rgba(74, 123, 247, 0.25);
  border-radius: 40rpx;
}

.pool-badge-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.pool-badge-text {
  font-size: 24rpx;
  color: #4A7BF7;
  font-weight: 500;
}

/* ========== 转盘区域 ========== */
.wheel-area {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-canvas {
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  box-shadow:
    0 0 0 8rpx #4A7BF7,
    0 0 0 14rpx #F0F5FF,
    0 0 0 20rpx rgba(74,123,247,0.3),
    0 8rpx 40rpx rgba(74,123,247,0.2);
}

/* 指针 */
.pointer {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pointer-arrow {
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-top: 40rpx solid #4A7BF7;
  filter: drop-shadow(0 4rpx 8rpx rgba(74,123,247,0.4));
}

.pointer-dot {
  width: 16rpx;
  height: 16rpx;
  background: #4A7BF7;
  border-radius: 50%;
  margin-top: -6rpx;
}

/* 外圈装饰灯 */
.wheel-lights {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
}

.light-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: -7rpx 0 0 -7rpx;
  transition: all 0.3s ease;
}

.light-dot.on {
  background: #FFD700;
  box-shadow: 0 0 10rpx 4rpx rgba(255,215,0,0.6);
}

.light-dot.off {
  background: rgba(255,215,0,0.25);
  box-shadow: none;
}

/* ========== 操作按钮（首页） ========== */
.action-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

/* 双按钮布局 */
.dual-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
  justify-content: center;
}

.quick-btn {
  flex: 1;
  max-width: 340rpx;
  height: 112rpx;
  line-height: 112rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  color: #4A7BF7;
  border: 3rpx solid #4A7BF7;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,123,247,0.15);
}

.quick-btn::after { border: none; }

.quick-btn-icon {
  font-size: 34rpx;
  line-height: 1;
  flex-shrink: 0;
}

.quick-btn-text {
  font-size: 34rpx;
  line-height: 1;
  white-space: nowrap;
}

.spin-btn {
  flex: 1;
  max-width: 340rpx;
  height: 112rpx;
  line-height: 112rpx;
  padding: 0 18rpx;
  background: linear-gradient(135deg, #4A7BF7, #6C9BFF);
  color: #FFFFFF;
  border: none;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 30rpx rgba(74,123,247,0.35);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.spin-btn::after {
  border: none;
}

.spin-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255,255,255,0.15) 50%,
    transparent 70%
  );
  animation: btn-shine 3s ease-in-out infinite;
}

@keyframes btn-shine {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.spin-btn.spinning {
  background: linear-gradient(135deg, #ccc, #aaa);
  box-shadow: none;
}

.spin-btn-text {
  position: relative;
  z-index: 1;
  display: block;
  line-height: 112rpx;
  white-space: nowrap;
}

.coupon-entry-btn {
  width: 360rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  background: #FFF3E0;
  color: #E67E22;
  border: 2rpx solid rgba(230,126,34,0.2);
  border-radius: 36rpx;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(230,126,34,0.14);
}

.coupon-entry-btn::after {
  border: none;
}

/* 连击提示 */
.combo-hint {
  position: fixed;
  top: 120rpx;
  right: 30rpx;
  z-index: 200;
  animation: combo-pop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes combo-pop {
  0% { transform: scale(0) rotate(-15deg); }
  60% { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.combo-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A7BF7;
  background: rgba(255,255,255,0.95);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,123,247,0.2);
}
