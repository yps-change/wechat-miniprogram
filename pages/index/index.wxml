<view class="page-bg">
  <!-- 粒子画布覆盖层 -->
  <canvas type="2d" id="particleCanvas" class="particle-canvas" bindtouchstart="onPageTouch"></canvas>

  <!-- 结果弹窗（顶层，独立于内容层） -->
  <view class="result-popup {{showResult ? 'show' : ''}}" catchtap="dismissResult">
    <view class="result-card" catchtap="">
      <view class="result-glow"></view>
      <text class="result-emoji">{{currentFood.emoji || '🍽️'}}</text>
      <text class="result-name">{{currentFood.name || ''}}</text>
      <view class="result-info">
        <text class="result-category">{{currentFood.categoryName || ''}}</text>
        <text class="result-price">￥{{currentFood.priceRange || ''}}</text>
      </view>
      <view class="result-tags" wx:if="{{currentFood.tags && currentFood.tags.length > 0}}">
        <text class="tag" wx:for="{{currentFood.tags}}" wx:key="*this">{{tagNames[item] || item}}</text>
      </view>
    </view>
  </view>

  <view class="container">
    <!-- 顶部标题区 -->
    <view class="header">
      <view class="title-row">
        <text class="title-emoji">🍽️</text>
        <text class="title">今天吃什么？</text>
      </view>
      <text class="subtitle">转一转，命运帮你选</text>
    </view>

    <!-- 转盘区域 -->
    <view class="wheel-area">
      <!-- 指针 -->
      <view class="pointer">
        <view class="pointer-arrow"></view>
        <view class="pointer-dot"></view>
      </view>
      <!-- 转盘Canvas -->
      <canvas type="2d" id="wheelCanvas" class="wheel-canvas"></canvas>
      <!-- 外圈装饰灯 -->
      <view class="wheel-lights">
        <view class="light-dot {{lightOn ? 'on' : 'off'}}" wx:for="{{12}}" wx:key="*this"
          style="transform: rotate({{index * 30}}deg) translateY(-296rpx);">
        </view>
      </view>
    </view>

    <!-- 操作按钮区 -->
    <view class="action-area">
      <button class="spin-btn {{spinning ? 'spinning' : ''}}" bindtap="onSpin" disabled="{{spinning}}">
        <text class="spin-btn-text">{{spinning ? '转动中...' : (showResult ? '再转一次' : '开始转盘')}}</text>
      </button>

      <view class="secondary-actions" wx:if="{{showResult}}">
        <button class="btn-confirm" bindtap="onConfirm">
          <text>🔥 就它了</text>
        </button>
        <button class="btn-candidates" bindtap="goToCandidates">
          <text>🎯 多来几个候选</text>
        </button>
      </view>
    </view>

    <!-- 分享入口 -->
    <view class="share-area" wx:if="{{showResult}}">
      <button class="share-btn" open-type="share" data-mode="random">
        🎲 帮我随机抽
      </button>
    </view>

    <!-- 连击提示 -->
    <view class="combo-hint" wx:if="{{comboCount > 1}}">
      <text class="combo-text">🔥 连转 {{comboCount}} 次！</text>
    </view>
  </view>
</view>
