<view class="home-page tab-page">
  <view class="header">
    <text class="home-eyebrow">GOOD FOOD, GOOD MOOD</text>
    <text class="title">今天，也要<text class="title-accent">好好吃饭。</text></text>
    <text class="subtitle">不纠结，把这一餐交给一点小运气。</text>
    <image class="header-spark" src="/images/theme/spark.png" mode="aspectFit" />
  </view>
  <view class="section-head">
    <text class="section-label">今日美食灵感</text>
    <button class="pool-badge" size="mini" bindtap="goToMenu" disabled="{{spinning}}"><text>{{poolLabel}}</text><text class="pool-arrow">›</text></button>
  </view>
  <view class="wheel-stage">
    <view class="wheel-area">
      <view class="wheel-leaf"></view>
      <view class="wheel-dot"></view>
      <view class="plate-rim">
        <canvas type="2d" id="wheelCanvas" class="wheel-canvas" bindtap="onSpin" aria-role="button" aria-label="开饭，点击转盘开始选择"></canvas>
      </view>
      <view class="plate-note"><image src="/images/theme/spark.png" mode="aspectFit" /><text>下一口，有惊喜</text></view>
    </view>
  </view>
  <view class="action-area">
    <button class="btn-primary spin-btn" bindtap="onSpin" disabled="{{spinning}}"><image class="inline-icon" src="/images/theme/spin.png" mode="aspectFit" /><text>{{spinning ? '美味正在转过来…' : '转一转，决定这一餐'}}</text><image class="inline-icon" src="/images/theme/arrow-light.png" mode="aspectFit" /></button>
    <button class="quick-btn" bindtap="onQuickPick" disabled="{{spinning}}"><text>已经饿了？</text><text class="quick-highlight">一键出结果 →</text></button>
    <button class="coupon-entry-btn home-coupon" bindtap="goToCoupons"><image class="coupon-entry-icon" src="/images/theme/ticket.png" mode="aspectFit" /><view class="coupon-entry-copy"><text class="coupon-entry-title">外卖红包，先领再点</text><text class="coupon-entry-hint">吃顿好的，也省一点</text></view><text class="coupon-entry-more">领券 ›</text></button>
  </view>
</view>
