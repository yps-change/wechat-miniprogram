<view class="page-bg">
  <!-- 粒子画布覆盖层 -->
  <canvas type="2d" id="particleCanvas" class="particle-canvas" bindtouchstart="onPageTouch"></canvas>

  <view class="container">
    <!-- 顶部标题区 -->
    <view class="header">
      <view class="title-row">
        <text class="title-emoji">🍽️</text>
        <text class="title">今天吃什么？</text>
      </view>
      <text class="subtitle">转一转，命运帮你选</text>
      <view class="pool-badge" bindtap="goToMenu">
        <text class="pool-badge-icon">{{useCustomMenu ? '📋' : '🎲'}}</text>
        <text class="pool-badge-text">{{poolLabel}}</text>
      </view>
    </view>

    <!-- 转盘区域 -->
    <view class="wheel-area">
      <!-- 指针 -->
      <view class="pointer">
        <view class="pointer-arrow"></view>
        <view class="pointer-dot"></view>
      </view>
      <!-- 转盘Canvas -->
      <canvas type="2d" id="wheelCanvas" class="wheel-canvas"></canvas>
      <!-- 外圈装饰灯 -->
      <view class="wheel-lights">
        <view class="light-dot {{lightOn ? 'on' : 'off'}}" wx:for="{{12}}" wx:key="*this"
          style="transform: rotate({{index * 30}}deg) translateY(-296rpx);">
        </view>
      </view>
    </view>

    <!-- 操作按钮区（首页常态按钮） -->
    <view class="action-area">
      <view class="dual-btns">
        <button class="quick-btn" bindtap="onQuickPick" disabled="{{spinning}}">
          <text class="quick-btn-icon">⚡</text>
          <text class="quick-btn-text">一键出结果</text>
        </button>
        <button class="spin-btn {{spinning ? 'spinning' : ''}}" bindtap="onSpin" disabled="{{spinning}}">
          <text class="spin-btn-text">{{spinning ? '转动中...' : '开始转盘'}}</text>
        </button>
      </view>
      <button class="coupon-entry-btn" bindtap="goToCoupons">🎟️ 领外卖券</button>
    </view>

    <!-- 连击提示 -->
    <view class="combo-hint" wx:if="{{comboCount > 1}}">
      <text class="combo-text">🔥 连转 {{comboCount}} 次！</text>
    </view>
  </view>
</view>
