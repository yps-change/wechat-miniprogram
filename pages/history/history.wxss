.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.clear-btn {
  font-size: 26rpx;
  color: var(--text-hint);
  padding: 10rpx 20rpx;
}

/* 历史列表 */
.history-list {
  width: 100%;
}

.history-group {
  margin-bottom: 30rpx;
}

.group-date {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 12rpx;
  display: block;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background-color: var(--card-bg);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.item-emoji {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.item-name {
  font-size: 30rpx;
  color: var(--text-color);
  flex: 1;
}

.item-source {
  font-size: 22rpx;
  color: var(--text-hint);
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}
