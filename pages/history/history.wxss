.history-receiver { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; margin-bottom: 28rpx; border-radius: 24rpx; background: var(--sage-light); border: 1rpx solid #DCE2D0; color: var(--sage-color); }
.receiver-text { flex: 1; min-width: 0; font-size: 25rpx; word-break: break-all; }
.receiving { animation: notice-in .35s ease both; }
@keyframes notice-in { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
.list-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.clear-btn.clear-btn { width: auto; margin: 0; background: transparent; color: var(--text-hint); padding: 14rpx 0 14rpx 20rpx; font-size: 23rpx; line-height: 1.5; }
.history-group { margin-bottom: 32rpx; }
.group-date { display: block; font-size: 22rpx; color: var(--sage-color); letter-spacing: 1rpx; margin: 0 0 14rpx 4rpx; }
.group-card { border: 1rpx solid var(--border-color); border-radius: var(--card-radius); background: var(--card-bg); overflow: hidden; }
.history-item { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; border-bottom: 1rpx solid var(--border-color); }
.history-item:last-child { border-bottom: none; }
.history-art { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; background: #F1EDDF; border-radius: 50%; }
.item-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.item-source { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 12rpx; background: #F2EEE3; color: var(--text-hint); font-size: 20rpx; }
.empty-state { margin-top: 42rpx; padding: 100rpx 28rpx; }
