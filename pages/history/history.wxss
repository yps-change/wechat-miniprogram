.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.history-receiver {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #EBF0FF, #FFFFFF);
  border-radius: 28rpx;
  color: var(--primary-color);
  box-shadow: 0 8rpx 28rpx rgba(74,123,247,0.14);
}

.history-receiver.receiving {
  animation: receiver-shake 0.82s ease both;
}

.receiver-icon {
  font-size: 42rpx;
}

.receiver-text {
  font-size: 26rpx;
  font-weight: 700;
}

@keyframes receiver-shake {
  0% { transform: scale(0.86) rotate(0deg); opacity: 0; }
  18% { transform: scale(1.12) rotate(-6deg); opacity: 1; }
  34% { transform: scale(1.1) rotate(6deg); }
  50% { transform: scale(1.06) rotate(-4deg); }
  70% { transform: scale(1.03) rotate(3deg); }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.clear-btn {
  font-size: 26rpx;
  color: var(--text-hint);
  padding: 10rpx 20rpx;
}

/* 历史列表 */
.history-list {
  width: 100%;
}

.history-group {
  margin-bottom: 30rpx;
}

.group-date {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 12rpx;
  display: block;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background-color: var(--card-bg);
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.item-emoji {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.item-name {
  font-size: 30rpx;
  color: var(--text-color);
  flex: 1;
}

.item-source {
  font-size: 22rpx;
  color: var(--text-hint);
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}
