.coupon-top { margin-bottom: 32rpx; }
.card-area { width: 100%; margin-bottom: 32rpx; }
.actions, .result-actions { display: flex; flex-direction: column; align-items: center; gap: 22rpx; width: 100%; }
.result-text { font-size: 28rpx; font-weight: 600; color: var(--sage-color); text-align: center; word-break: break-all; margin-bottom: 8rpx; }
.shaking { animation: shake .45s ease-in-out; }
@keyframes shake { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-1deg); } 70% { transform: rotate(1deg); } }
