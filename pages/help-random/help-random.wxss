.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.from-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-color);
}

.card-area {
  margin-bottom: 50rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.result-text {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 600;
  margin-bottom: 10rpx;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-6rpx); }
  20%, 40%, 60%, 80% { transform: translateX(6rpx); }
}

.shaking {
  animation: shake 0.5s ease-in-out;
}

/* 领券入口（顶部醒目位，与首页同款薄荷绿） */
.coupon-top {
  display: flex;
  justify-content: center;
  margin: 10rpx 0 30rpx;
}

.coupon-entry-btn {
  width: 480rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  background: linear-gradient(135deg, #34D1A5, #1FB98E);
  color: #FFFFFF;
  border: none;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 26rpx rgba(31,185,142,0.32);
  animation: coupon-breathe 2s ease-in-out infinite;
}

@keyframes coupon-breathe {
  0%, 100% { transform: scale(1); box-shadow: 0 10rpx 26rpx rgba(31,185,142,0.32); }
  50% { transform: scale(1.04); box-shadow: 0 14rpx 32rpx rgba(31,185,142,0.45); }
}

.coupon-entry-btn::after {
  border: none;
}
