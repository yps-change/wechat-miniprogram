<view class="page-shell help-random-page">
  <view class="page-heading"><text class="page-eyebrow">{{fromName}} 的美食求助</text><text class="page-title">这一餐，<text class="page-title-accent">你来做主。</text></text><text class="page-description">帮TA抽一道，把纠结变成一个小惊喜。</text></view>
  <view class="coupon-top"><button class="coupon-entry-btn" bindtap="goToCoupons"><image class="coupon-entry-icon" src="/images/theme/ticket.png" mode="aspectFit" /><view class="coupon-entry-copy"><text class="coupon-entry-title">好好吃饭，也省一点</text><text class="coupon-entry-hint">先领一张外卖券</text></view><text class="coupon-entry-more">去领券 ›</text></button></view>
  <view class="card-area"><food-card food="{{currentFood}}" flipped="{{isFlipped}}" /></view>
  <view class="actions"><button class="btn-primary {{shaking ? 'shaking' : ''}}" bindtap="onRandomPick" disabled="{{shaking}}" wx:if="{{!isFlipped}}">帮TA抽一个</button><view class="result-actions" wx:if="{{isFlipped}}"><text class="result-text">你帮TA抽到了：{{currentFood.name}}</text><button class="btn-primary" bindtap="goToIndex">我也来试试</button><button class="btn-secondary" bindtap="onRandomPick" disabled="{{shaking}}">再抽一个</button></view></view>
</view>
