.candidates-page { display: flex; flex-direction: column; }
.candidate-list { margin-bottom: 16rpx; }
.candidate-item { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 22rpx; background: var(--card-bg); border: 1rpx solid var(--border-color); border-radius: 26rpx; margin-bottom: 18rpx; }
.candidate-art { width: 108rpx; height: 108rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #F1EDDF; border-radius: 24rpx; }
.item-info { flex: 1; min-width: 0; }
.item-name { display: block; font-size: 29rpx; font-weight: 650; word-break: break-all; }
.item-category { display: block; color: var(--text-hint); font-size: 21rpx; margin-top: 10rpx; }
.replace-btn.replace-btn { width: auto; margin: 0; flex-shrink: 0; min-height: 68rpx; padding: 17rpx 15rpx; border-radius: 16rpx; color: var(--primary-color); background: var(--primary-light); font-size: 22rpx; line-height: 1.5; }
.actions { display: flex; flex-direction: column; gap: 24rpx; margin-top: 32rpx; }
