.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-color);
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 10rpx;
}

/* 候选列表 */
.candidate-list {
  width: 100%;
  margin-bottom: 40rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-emoji {
  font-size: 48rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color);
}

.item-category {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.item-right {
  display: flex;
  align-items: center;
}

.replace-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 10rpx 24rpx;
  border: 2rpx solid var(--primary-color);
  border-radius: 20rpx;
}

/* 操作区 */
.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-top: auto;
  padding-bottom: 40rpx;
}

.share-btn {
  background-color: transparent;
  color: var(--primary-color);
  font-size: 28rpx;
  border: 2rpx solid var(--primary-color);
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  line-height: 1.4;
}

.share-btn::after {
  border: none;
}
