<view class="page">
  <!-- 顶部装饰 -->
  <view class="top-decor">
    <view class="circle c1"></view>
    <view class="circle c2"></view>
    <view class="circle c3"></view>
  </view>

  <!-- 食物展示卡片 -->
  <view class="food-photo-card">
    <view class="photo-bg">
      <view class="photo-glow"></view>
      <text class="food-emoji">{{food.emoji || '🍽️'}}</text>
    </view>
    <view class="photo-label">
      <text class="label-text">✨ 今日推荐</text>
    </view>
  </view>

  <!-- 食物信息 -->
  <view class="food-info">
    <text class="food-name">{{food.name || '加载中...'}}</text>
    <view class="info-row">
      <text class="food-category">{{food.categoryName || ''}}</text>
      <text class="food-price">￥{{food.priceRange || ''}}</text>
    </view>
    <view class="food-tags" wx:if="{{food.tags && food.tags.length > 0}}">
      <text class="tag" wx:for="{{food.tags}}" wx:key="*this">{{tagNames[item] || item}}</text>
    </view>
  </view>

  <!-- 附近餐馆（配置腾讯位置服务 Key 后显示） -->
  <view class="nearby-section" wx:if="{{nearbyEnabled}}">
    <block wx:if="{{nearbyList.length > 0}}">
      <map class="nearby-map"
           latitude="{{mapLatitude}}"
           longitude="{{mapLongitude}}"
           scale="14"
           markers="{{markers}}"
           include-points="{{includePoints}}"
           show-location="{{true}}"
           enable-zoom="{{true}}"
           enable-scroll="{{true}}"></map>
      <!-- 降级搜索提示 -->
      <view class="nearby-note" wx:if="{{nearbyNote}}">{{nearbyNote}}</view>
      <!-- 由近及远列表，点任意一家打开导航 -->
      <view class="nearby-list">
        <view class="nearby-item" wx:for="{{nearbyList}}" wx:key="rank"
              data-index="{{index}}" bindtap="onShopTap">
          <view class="nearby-rank {{index === 0 ? 'rank-first' : ''}}">{{item.rank}}</view>
          <view class="nearby-info">
            <text class="nearby-title">{{item.title}}</text>
            <text class="nearby-address">{{item.address}}</text>
          </view>
          <view class="nearby-right">
            <text class="nearby-distance">{{item.distanceText}}</text>
            <text class="nearby-nav">导航 ›</text>
          </view>
        </view>
      </view>
    </block>
    <view class="nearby-loading" wx:elif="{{nearbyLoading}}">
      <text>🔍 正在找附近的「{{food.name}}」…</text>
    </view>
    <button class="nearby-btn" wx:else bindtap="findNearby">
      <text>📍 看看附近哪家店有「{{food.name}}」</text>
    </button>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="confirm-btn" bindtap="onConfirm">
      <text>🔥 就它了！</text>
    </button>
    <view class="sub-actions">
      <button class="again-btn" bindtap="onAgain">
        <text>🎲 换一个</text>
      </button>
      <button class="back-btn" bindtap="goBack">
        <text>← 回去转转盘</text>
      </button>
    </view>
  </view>
</view>
