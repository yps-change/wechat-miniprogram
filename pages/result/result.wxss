.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: var(--card-bg);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  margin-bottom: 60rpx;
}

.emoji {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.category {
  font-size: 28rpx;
  color: var(--text-secondary);
  background-color: var(--primary-light);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.price {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.tag {
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 400rpx;
}
