.result-card { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 30rpx 28rpx 36rpx; }
.result-label { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--sage-color); letter-spacing: 3rpx; }
.result-label image { width: 24rpx; height: 24rpx; }
.food-plate { display: flex; align-items: center; justify-content: center; width: 310rpx; height: 310rpx; margin: 26rpx 0 28rpx; border-radius: 50%; background: #F1E9D9; border: 18rpx solid #FFFDF7; box-shadow: 0 0 0 1rpx #D9D0BF, 0 10rpx 24rpx rgba(118, 100, 71, .10), inset 0 0 0 2rpx #E7DFCE; }
.food-name { display: block; font-size: 46rpx; font-weight: 800; line-height: 1.4; word-break: break-all; }
.info-row { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-top: 20rpx; flex-wrap: wrap; }
.food-category { font-size: 23rpx; padding: 5rpx 17rpx; background: var(--sage-light); color: var(--sage-color); border-radius: 20rpx; }
.food-price { font-size: 29rpx; color: var(--primary-color); font-weight: 650; }
.food-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin-top: 20rpx; }
.tag { font-size: 22rpx; color: var(--text-hint); background: #F3EEE3; border-radius: 12rpx; padding: 4rpx 15rpx; }
.food-quip { display: block; margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx dashed #DDD4C2; width: 100%; font-family: 'Songti SC', 'Noto Serif CJK SC', serif; font-size: 25rpx; color: #857052; line-height: 1.8; }
.actions { margin-top: 28rpx; }
.sub-actions { display: flex; align-items: center; justify-content: center; gap: 18rpx; margin-top: 10rpx; }
.action-divider { color: #C5BAA6; }
.nearby-section { margin-top: 20rpx; }
.nearby-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 0 0 20rpx; }
.nearby-map { width: 100%; height: 340rpx; border-radius: 24rpx; overflow: hidden; }
.nearby-note { font-size: 23rpx; color: var(--text-hint); margin: 16rpx 0; }
.nearby-list { border: 1rpx solid var(--border-color); border-radius: 24rpx; background: var(--card-bg); overflow: hidden; margin-top: 18rpx; }
.nearby-item { display: flex; align-items: center; padding: 24rpx 20rpx; border-bottom: 1rpx solid var(--border-color); gap: 16rpx; }
.nearby-item:last-child { border: 0; }
.nearby-rank { width: 38rpx; height: 38rpx; line-height: 38rpx; text-align: center; background: #F1EBDD; color: var(--text-hint); border-radius: 12rpx; flex-shrink: 0; font-size: 22rpx; }
.rank-first { background: var(--primary-color); color: #FFF9EE; }
.nearby-info { flex: 1; min-width: 0; }
.nearby-title { display: block; font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nearby-address { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--text-hint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nearby-right { flex-shrink: 0; text-align: right; }
.nearby-distance { display: block; color: var(--primary-color); font-size: 26rpx; font-weight: 650; }
.nearby-nav { display: block; margin-top: 4rpx; color: var(--sage-color); font-size: 22rpx; }
.nearby-loading { padding: 32rpx 22rpx; background: var(--sage-light); border-radius: 24rpx; color: var(--sage-color); font-size: 25rpx; text-align: center; }
.nearby-btn.nearby-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx 26rpx; border-radius: 24rpx; background: var(--sage-light); border: 1rpx solid #DDE3D1; color: var(--sage-color); font-size: 25rpx; text-align: left; line-height: 1.7; }
.nearby-arrow { flex-shrink: 0; font-size: 34rpx; }
.share-actions { display: flex; gap: 18rpx; margin-top: 32rpx; }
.share-option.share-option { width: auto; margin: 0; flex: 1; min-width: 0; background: var(--card-bg); border: 1rpx solid var(--border-color); border-radius: 24rpx; padding: 25rpx 18rpx; text-align: left; line-height: 1.6; }
.share-title { display: block; font-size: 25rpx; font-weight: 650; }
.share-hint { display: block; font-size: 20rpx; color: var(--text-hint); margin-top: 10rpx; }
