/* 页面背景 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EBF0FF 0%, #FFFFFF 40%, #F5F8FF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 顶部装饰圆 */
.top-decor {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.circle {
  position: absolute;
  border-radius: 50%;
}

.c1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -60rpx;
  background: radial-gradient(circle, rgba(74,123,247,0.15) 0%, transparent 70%);
}

.c2 {
  width: 200rpx;
  height: 200rpx;
  top: 50rpx;
  left: -80rpx;
  background: radial-gradient(circle, rgba(108,155,255,0.12) 0%, transparent 70%);
}

.c3 {
  width: 150rpx;
  height: 150rpx;
  top: 180rpx;
  right: 100rpx;
  background: radial-gradient(circle, rgba(255,105,180,0.08) 0%, transparent 70%);
}

/* ========== 食物展示卡片 ========== */
.food-photo-card {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
  animation: card-in 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes card-in {
  0% { transform: scale(0.5) translateY(40rpx); opacity: 0; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

.photo-bg {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  border-radius: 40rpx;
  background: linear-gradient(145deg, #4A7BF7 0%, #6C9BFF 50%, #A8C4FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 20rpx 60rpx rgba(74,123,247,0.3),
    inset 0 -4rpx 20rpx rgba(0,0,0,0.05);
  overflow: hidden;
}

.photo-glow {
  position: absolute;
  width: 200%;
  height: 200%;
  top: -50%;
  left: -50%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(255,255,255,0.1) 60deg,
    transparent 120deg,
    rgba(255,255,255,0.08) 200deg,
    transparent 360deg
  );
  animation: glow-spin 6s linear infinite;
}

@keyframes glow-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.food-emoji {
  font-size: 180rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.15));
  animation: emoji-pop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.3s both;
}

@keyframes emoji-pop {
  0% { transform: scale(0) rotate(-20deg); }
  60% { transform: scale(1.15) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.photo-label {
  position: absolute;
  bottom: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FFFFFF;
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.label-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A7BF7;
}

/* ========== 食物信息 ========== */
.food-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 50rpx;
  animation: info-in 0.5s ease 0.4s both;
}

@keyframes info-in {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.food-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  text-align: center;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.food-category {
  font-size: 28rpx;
  color: #4A7BF7;
  background: #EBF0FF;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.food-price {
  font-size: 34rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.food-tags {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.tag {
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* ========== 附近餐馆 ========== */
.nearby-section {
  width: 100%;
  max-width: 640rpx;
  margin-bottom: 40rpx;
  animation: info-in 0.5s ease 0.5s both;
}

.nearby-map {
  width: 100%;
  height: 340rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.nearby-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 22rpx 26rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(74,123,247,0.12);
}

.nearby-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.nearby-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nearby-address {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nearby-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.nearby-distance {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.nearby-nav {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4A7BF7;
  font-weight: 600;
}

.nearby-loading {
  padding: 28rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.nearby-btn {
  width: 100%;
  padding: 24rpx 0;
  background: #EBF0FF;
  color: #4A7BF7;
  border: none;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.nearby-btn::after { border: none; }

/* ========== 操作按钮 ========== */
.actions {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  animation: actions-in 0.4s ease 0.6s both;
}

@keyframes actions-in {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.confirm-btn {
  width: 100%;
  padding: 34rpx 0;
  background: linear-gradient(135deg, #4A7BF7, #6C9BFF);
  color: #FFFFFF;
  border: none;
  border-radius: 60rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 30rpx rgba(74,123,247,0.35);
}

.confirm-btn::after { border: none; }

.sub-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.again-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #FFFFFF;
  color: #4A7BF7;
  border: 3rpx solid #4A7BF7;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.again-btn::after { border: none; }

.back-btn {
  flex: 1;
  padding: 24rpx 0;
  background: #F5F5F5;
  color: #666;
  border: none;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.back-btn::after { border: none; }
