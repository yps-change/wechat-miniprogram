.menu-page {
  min-height: 100vh;
  padding: 40rpx 30rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFFFFF 0%, #F0F5FF 52%, #E0EBFF 100%);
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 34rpx;
}

.header-emoji {
  font-size: 58rpx;
  margin-bottom: 8rpx;
}

.title {
  font-size: 46rpx;
  font-weight: 800;
  color: #2D5BE3;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #777;
}

.menu-card {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: rgba(255,255,255,0.94);
  border: 2rpx solid rgba(74,123,247,0.16);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 28rpx rgba(74,123,247,0.1);
}

.menu-title-row,
.menu-title-left,
.menu-input-row,
.list-title-row {
  display: flex;
  align-items: center;
}

.menu-title-row,
.list-title-row {
  justify-content: space-between;
}

.menu-title-left {
  gap: 10rpx;
}

.menu-icon {
  font-size: 34rpx;
}

.menu-title,
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D5BE3;
}

.menu-switch {
  transform: scale(0.82);
}

.menu-current {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #777;
}

.menu-input-row {
  gap: 14rpx;
  margin-top: 20rpx;
}

.menu-input {
  flex: 1;
  height: 78rpx;
  padding: 0 24rpx;
  background: #F6F8FF;
  border-radius: 39rpx;
  font-size: 27rpx;
  color: #333;
}

.menu-add-btn {
  width: 140rpx;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0;
  background: linear-gradient(135deg, #4A7BF7, #6C9BFF);
  color: #FFFFFF;
  border-radius: 39rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-add-btn::after,
.history-btn::after {
  border: none;
}

.share-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  background: #FFF3E0;
  color: #E67E22;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.share-btn::after { border: none; }

.history-btn {
  margin-top: 22rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  background: #EBF0FF;
  color: #4A7BF7;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.count-text {
  font-size: 24rpx;
  color: #999;
}

.menu-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.menu-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  background: #EBF0FF;
  color: #2D5BE3;
  border-radius: 26rpx;
  font-size: 26rpx;
}

.menu-tag-close {
  color: #7A8FDB;
  font-size: 30rpx;
  line-height: 1;
}

.empty {
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.empty-emoji {
  font-size: 88rpx;
  margin-bottom: 18rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}
