.menu-card { margin-bottom: 24rpx; }
.switch-card { background: var(--sage-light); border-color: #DCE2D0; }
.menu-title-row, .menu-title-left, .menu-input-row, .list-title-row { display: flex; align-items: center; }
.menu-title-row, .list-title-row { justify-content: space-between; gap: 14rpx; }
.menu-title-left { gap: 14rpx; }
.menu-switch { transform: scale(.85); transform-origin: right center; flex-shrink: 0; }
.menu-current { display: block; color: var(--sage-color); font-size: 23rpx; margin-top: 10rpx; }
.menu-input-row { gap: 14rpx; margin-top: 24rpx; }
.menu-input { flex: 1; min-width: 0; }
.menu-add-btn.menu-add-btn { width: 116rpx; min-height: 88rpx; line-height: 88rpx; padding: 0; border-radius: 18rpx; background: var(--primary-color); color: #FFF9EE; font-size: 27rpx; flex-shrink: 0; }
.history-btn.history-btn { display: flex; align-items: center; gap: 14rpx; padding: 24rpx 0; margin-top: 10rpx; border-bottom: 1rpx solid var(--border-color); width: 100%; background: transparent; text-align: left; color: var(--text-secondary); font-size: 24rpx; line-height: 1.5; }
.row-arrow { margin-left: auto; font-size: 30rpx; }
.share-btn.share-btn { width: 100%; background: transparent; padding: 24rpx 0 0; color: var(--primary-color); font-size: 25rpx; line-height: 1.6; text-align: left; }
.count-text { padding: 6rpx 14rpx; border-radius: 24rpx; background: #F1EBDD; color: var(--text-secondary); font-size: 21rpx; flex-shrink: 0; }
.menu-tags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 26rpx; }
.menu-tag { display: flex; align-items: center; max-width: 100%; gap: 4rpx; border: 1rpx solid #DED5C4; border-radius: 16rpx; background: #F6F1E5; padding-left: 20rpx; font-size: 25rpx; }
.menu-tag-name { flex: 1; min-width: 0; word-break: break-all; padding: 10rpx 0; }
.menu-tag-close.menu-tag-close { flex-shrink: 0; width: 66rpx; min-height: 66rpx; padding: 0; background: transparent; color: #8C7C65; line-height: 66rpx; font-size: 32rpx; }
.empty-state { padding: 44rpx 0 24rpx; }
