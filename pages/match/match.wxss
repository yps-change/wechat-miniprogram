.inviter-card { display: flex; flex-direction: column; align-items: center; border: 1rpx solid var(--border-color); background: var(--card-bg); border-radius: 30rpx; padding: 32rpx; }
.card-kicker { font-size: 21rpx; color: var(--sage-color); letter-spacing: 3rpx; }
.inviter-plate { display: flex; align-items: center; justify-content: center; width: 264rpx; height: 264rpx; border-radius: 50%; background: #EFE4D0; border: 14rpx solid #FFFDF7; box-shadow: 0 0 0 1rpx #DDD3C0; margin: 26rpx 0; }
.card-name { font-size: 38rpx; font-weight: 700; text-align: center; word-break: break-all; }
.spin-hint { display: block; text-align: center; font-size: 24rpx; color: var(--text-secondary); margin: 30rpx 0; }
.shaking { animation: shake .45s ease-in-out; }
@keyframes shake { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-1deg); } 70% { transform: rotate(1deg); } }
.score-wrap { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0 34rpx; }
.score-caption { font-size: 18rpx; letter-spacing: 4rpx; color: var(--sage-color); }
.score-num { font-size: 150rpx; line-height: 1.2; font-family: Georgia, serif; font-style: italic; color: var(--primary-color); margin-top: 8rpx; letter-spacing: -4rpx; }
.score-unit { font-size: 52rpx; margin-left: 6rpx; }
.score-level { margin-top: 16rpx; font-size: 27rpx; color: var(--sage-color); padding: 8rpx 26rpx; background: var(--sage-light); border-radius: 30rpx; }
.vs-row { display: flex; align-items: stretch; gap: 14rpx; margin: 10rpx 0 36rpx; }
.vs-card { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 28rpx 16rpx; background: var(--card-bg); border: 1rpx solid var(--border-color); border-radius: 26rpx; text-align: center; }
.vs-name { display: block; font-size: 27rpx; font-weight: 650; word-break: break-all; margin-top: 16rpx; }
.vs-owner { display: block; margin-top: 10rpx; font-size: 21rpx; color: var(--text-hint); }
.vs-mark { font-family: Georgia, serif; font-style: italic; font-size: 35rpx; color: #A48B62; align-self: center; }
.sub-actions { display: flex; justify-content: center; gap: 26rpx; margin-top: 12rpx; }
.invalid-action { margin-top: 32rpx; }
