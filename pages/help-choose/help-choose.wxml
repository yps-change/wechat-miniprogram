<view class="container">
  <view class="header">
    <text class="from-text" wx:if="{{mode !== 'received'}}">{{fromName}} 邀请你来帮忙</text>
    <text class="title" wx:if="{{mode === 'received' && isAuthor}}">你已完成推荐</text>
    <text class="title" wx:elif="{{mode === 'received'}}">好友帮你推荐了</text>
    <text class="title" wx:elif="{{mode === 'recommend'}}">推荐一道你爱吃的</text>
    <text class="title" wx:elif="{{mode === 'menu'}}">帮TA推荐一道菜单</text>
    <text class="title" wx:else>帮TA从这几个里选一个！</text>
  </view>

  <!-- 领券入口：非推荐模式放顶部，推荐模式放「就推荐这个」下面 -->
  <view class="coupon-top" wx:if="{{mode !== 'recommend'}}">
    <button class="coupon-entry-btn" bindtap="goToCoupons">🎟️ 领外卖券</button>
  </view>

  <view class="received-panel" wx:if="{{mode === 'received'}}">
    <text class="received-from" wx:if="{{!isAuthor}}">来自「{{fromName}}」的推荐</text>
    <!-- 关系沉淀：累计帮选次数 -->
    <text class="help-count" wx:if="{{!isAuthor && helpCount > 1}}">这已经是 TA 第 {{helpCount}} 次帮你选饭啦 ❤️</text>
    <text class="received-emoji">{{receivedFood.emoji}}</text>
    <text class="received-name">{{receivedFood.name}}</text>
    <text class="received-description">{{receivedFood.categoryName}} · {{receivedFood.priceRange}}元 · {{receivedFood.description}}</text>
    <!-- 推荐人的留言 -->
    <view class="received-msg" wx:if="{{receivedMsg}}">💬 “{{receivedMsg}}”</view>

    <!-- 推荐人本人查看：不入历史 -->
    <block wx:if="{{isAuthor}}">
      <text class="author-note">这是你推荐给 TA 的，等 TA 打开就会收到并存入TA的历史～</text>
      <button class="btn-primary" bindtap="goToIndex">回到首页</button>
    </block>

    <!-- 接收者查看：手动点击才加入历史 -->
    <block wx:else>
      <button class="btn-primary" bindtap="addRecommendationToHistory">{{added ? '已加入历史，去看看' : '加入历史，去看看'}}</button>
    </block>
  </view>


  <!-- 直接推荐模式 -->
  <view class="recommend-panel" wx:if="{{mode === 'recommend'}}">
    <!-- 未提交：填写推荐 -->
    <block wx:if="{{!submitted}}">
      <text class="recommend-hint">告诉TA一道你觉得好吃的</text>
      <input class="recommend-input" value="{{recommendationInput}}" placeholder="例如：酸菜鱼、牛肉面" bindinput="onRecommendationInput" />

      <input class="recommend-input recommend-name" type="nickname" value="{{recommenderName}}" placeholder="点这里填昵称（微信名一键带入，选填）" bindinput="onRecommenderNameInput" bindblur="onRecommenderNameInput" />

      <input class="recommend-input recommend-msg" value="{{recommendMsg}}" placeholder="给TA捎一句话（选填），如：这家的酸菜鱼绝了" bindinput="onRecommendMsgInput" />

      <!-- 快捷建议（来自TA的专属菜单） -->
      <view class="suggestion-wrap" wx:if="{{suggestions.length > 0}}">
        <text class="suggestion-label">TA常吃的，点一下直接填入：</text>
        <view class="suggestion-chips">
          <text class="suggestion-chip {{recommendationInput === item ? 'active' : ''}}"
                wx:for="{{suggestions}}" wx:key="*this"
                bindtap="onPickSuggestion" data-name="{{item}}">{{item}}</text>
        </view>
      </view>

      <button class="btn-primary recommend-submit" bindtap="submitRecommendation">就推荐这个</button>
      <button class="coupon-entry-btn coupon-below" bindtap="goToCoupons">🎟️ 领外卖券</button>
    </block>

    <!-- 已提交：突出“发回给TA”这一步 -->
    <block wx:else>
      <view class="recommend-done">
        <text class="done-emoji">✅</text>
        <text class="done-title">已选好：{{recommendationInput}}</text>
        <text class="done-tip">最后一步 👇 把推荐发回给TA，TA 才能收到并存入历史</text>
      </view>
      <button class="btn-primary share-back-btn" open-type="share">📤 把推荐发回给TA</button>
      <text class="redo-link" bindtap="redoRecommendation">重新选一个</text>
      <button class="coupon-entry-btn coupon-below" bindtap="goToCoupons">🎟️ 领外卖券</button>
    </block>
  </view>



  <!-- 候选列表 -->
  <view class="candidate-list" wx:if="{{mode !== 'recommend' && mode !== 'received'}}">
    <view class="candidate-item {{chosen === item.id ? 'chosen' : ''}}" 
          wx:for="{{candidates}}" 
          wx:key="id"
          bindtap="onChoose"
          data-id="{{item.id}}">
      <text class="item-emoji">{{item.emoji}}</text>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-category">{{item.categoryName}} · ￥{{item.priceRange}}</text>
      </view>
      <view class="check-mark" wx:if="{{chosen === item.id}}">✓</view>
    </view>
  </view>

  <!-- 选择结果 -->
  <view class="result" wx:if="{{chosenFood}}">
    <text class="result-text">你推荐TA吃：{{chosenFood.emoji}} {{chosenFood.name}}</text>
    <button class="share-result-btn" open-type="share">📤 分享推荐给TA</button>
  </view>

  <!-- 底部引导 -->
  <view class="footer">
    <button class="btn-primary" bindtap="goToIndex">我也来试试</button>
  </view>
</view>
