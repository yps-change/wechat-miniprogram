<view class="page-shell help-choose-page">
  <view class="page-heading">
    <text class="page-eyebrow" wx:if="{{mode !== 'received'}}">{{fromName}} 邀请你来帮忙</text><text class="page-eyebrow" wx:else>A MEAL PICKED WITH CARE</text>
    <text class="page-title" wx:if="{{mode === 'received' && isAuthor}}">一份推荐，<text class="page-title-accent">一份心意。</text></text>
    <text class="page-title" wx:elif="{{mode === 'received'}}">好友选的，<text class="page-title-accent">值得一尝。</text></text>
    <text class="page-title" wx:elif="{{mode === 'recommend'}}">把你的心头好，<text class="page-title-accent">推荐给TA。</text></text>
    <text class="page-title" wx:elif="{{mode === 'menu'}}">TA的菜单，<text class="page-title-accent">你来挑。</text></text>
    <text class="page-title" wx:else>这几道里，<text class="page-title-accent">你选哪道？</text></text>
  </view>
  <view class="coupon-top" wx:if="{{mode !== 'recommend'}}"><button class="coupon-entry-btn" bindtap="goToCoupons"><image class="coupon-entry-icon" src="/images/theme/ticket.png" mode="aspectFit" /><view class="coupon-entry-copy"><text class="coupon-entry-title">好好吃饭，也省一点</text><text class="coupon-entry-hint">下单前先领一张外卖券</text></view><text class="coupon-entry-more">去领券 ›</text></button></view>
  <view class="surface received-panel" wx:if="{{mode === 'received'}}">
    <text class="received-from" wx:if="{{!isAuthor}}">来自「{{fromName}}」的推荐</text>
    <text class="help-count" wx:if="{{!isAuthor && helpCount > 1}}">这已经是TA第 {{helpCount}} 次帮你选饭啦</text>
    <view class="received-plate"><food-illustration food="{{receivedFood}}" size="190" /></view>
    <text class="received-name">{{receivedFood.name}}</text>
    <text class="received-description">{{receivedFood.categoryName}} · {{receivedFood.priceRange}}元 · {{receivedFood.description}}</text>
    <view class="received-msg" wx:if="{{receivedMsg}}">“{{receivedMsg}}”</view>
    <block wx:if="{{isAuthor}}"><text class="author-note">这是你推荐给TA的，等TA打开就会收到；TA可以选择加入自己的历史。</text><button class="btn-primary" bindtap="goToIndex">回到首页</button></block>
    <block wx:else><button class="btn-primary" bindtap="addRecommendationToHistory">{{added ? '已加入历史，去看看' : '加入历史，去看看'}}</button></block>
  </view>
  <view class="surface recommend-panel" wx:if="{{mode === 'recommend'}}">
    <block wx:if="{{!submitted}}">
      <text class="section-title">告诉TA一道你觉得好吃的</text>
      <text class="field-label">想推荐的菜</text><input class="field-input" value="{{recommendationInput}}" placeholder="例如：酸菜鱼、牛肉面" placeholder-class="field-placeholder" bindinput="onRecommendationInput" />
      <text class="field-label">你的昵称 · 选填</text><input class="field-input" type="nickname" value="{{recommenderName}}" placeholder="点这里填昵称，可带入微信名" placeholder-class="field-placeholder" bindinput="onRecommenderNameInput" bindblur="onRecommenderNameInput" />
      <text class="field-label">给TA捎句话 · 选填</text><input class="field-input" value="{{recommendMsg}}" placeholder="例如：这家的酸菜鱼真的不错" placeholder-class="field-placeholder" bindinput="onRecommendMsgInput" />
      <view class="suggestion-wrap" wx:if="{{suggestions.length > 0}}"><text class="suggestion-label">TA常吃的，点一下直接填入</text><view class="suggestion-chips"><text class="suggestion-chip {{recommendationInput === item ? 'active' : ''}}" wx:for="{{suggestions}}" wx:key="*this" bindtap="onPickSuggestion" data-name="{{item}}">{{item}}</text></view></view>
      <button class="btn-primary recommend-submit" bindtap="submitRecommendation">就推荐这个 →</button>
      <button class="coupon-entry-btn coupon-below" bindtap="goToCoupons"><image class="coupon-entry-icon" src="/images/theme/ticket.png" mode="aspectFit" /><view class="coupon-entry-copy"><text class="coupon-entry-title">吃顿好的，也省一点</text><text class="coupon-entry-hint">先领一张外卖券</text></view><text class="coupon-entry-more">去领券 ›</text></button>
    </block>
    <block wx:else>
      <view class="recommend-done"><view class="done-mark">✓</view><text class="done-title">已选好：{{recommendationInput}}</text><text class="done-tip">还差最后一步：发回给TA。TA打开后，才能收到你的推荐。</text></view>
      <button class="btn-primary share-back-btn" open-type="share">把推荐发回给TA →</button><button class="text-button redo-link" bindtap="redoRecommendation">重新选一个</button>
      <button class="coupon-entry-btn coupon-below" bindtap="goToCoupons"><image class="coupon-entry-icon" src="/images/theme/ticket.png" mode="aspectFit" /><view class="coupon-entry-copy"><text class="coupon-entry-title">吃顿好的，也省一点</text><text class="coupon-entry-hint">下单前先领券</text></view><text class="coupon-entry-more">去领券 ›</text></button>
    </block>
  </view>
  <view class="candidate-list" wx:if="{{mode !== 'recommend' && mode !== 'received'}}"><view class="candidate-item {{chosen === item.id ? 'chosen' : ''}}" wx:for="{{candidates}}" wx:key="id" bindtap="onChoose" data-id="{{item.id}}"><view class="candidate-art"><food-illustration food="{{item}}" size="88" /></view><view class="item-info"><text class="item-name">{{item.name}}</text><text class="item-category">{{item.categoryName}} · ￥{{item.priceRange}}</text></view><view class="check-mark {{chosen === item.id ? 'checked' : ''}}"><text wx:if="{{chosen === item.id}}">✓</text></view></view></view>
  <view class="result" wx:if="{{chosenFood}}"><text class="result-text">你推荐TA吃：{{chosenFood.name}}</text><button class="btn-primary" open-type="share">把推荐分享给TA →</button></view>
  <view class="footer"><button class="btn-secondary" bindtap="goToIndex">我也来试试</button></view>
</view>
