.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.from-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-color);
}

.received-panel {
  width: 100%;
  padding: 48rpx 30rpx;
  box-sizing: border-box;
  background: var(--card-bg);
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(74,123,247,0.1);
}

.received-panel .btn-primary {
  white-space: nowrap;
}

.received-emoji,
.received-name,
.received-description {
  display: block;
}

.received-emoji {
  font-size: 96rpx;
}

.received-name {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-color);
}

.received-description {
  margin: 18rpx 0 32rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.author-note {
  display: block;
  margin: 0 0 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--primary-color);
  text-align: center;
}

.recommend-panel {
  width: 100%;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
  background: var(--card-bg);
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(74,123,247,0.1);
}

.recommend-hint {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.recommend-input {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 41rpx;
  background: #F6F8FF;
  text-align: left;
  font-size: 28rpx;
}

.recommend-submit {
  margin-top: 28rpx;
}

/* 快捷建议 chip */
.suggestion-wrap {
  margin-top: 28rpx;
  text-align: left;
}

.suggestion-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.suggestion-chip {
  padding: 12rpx 28rpx;
  background: #F6F8FF;
  color: var(--primary-color);
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.suggestion-chip.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
  font-weight: 600;
}

/* 推荐完成态：突出“发回给TA” */
.recommend-done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.done-emoji {
  font-size: 72rpx;
}

.done-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
}

.done-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  text-align: center;
}

.share-back-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background: var(--primary-color);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(74,123,247,0.35);
  animation: share-pulse 1.6s ease-in-out infinite;
}

.share-back-btn::after {
  border: none;
}

@keyframes share-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

.redo-link {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-hint);
  text-align: center;
  text-decoration: underline;
}

/* 候选列表 */
.candidate-list {
  width: 100%;
  margin-bottom: 30rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.candidate-item.chosen {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
}

.item-emoji {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.item-category {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.check-mark {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 700;
}

/* 结果 */
.result {
  text-align: center;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.result-text {
  display: block;
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.share-result-btn {
  margin: 24rpx auto 0;
  width: 82%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  background: #FFF3E0;
  color: #E67E22;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.share-result-btn::after {
  border: none;
}

/* 底部 */
.footer {
  margin-top: auto;
  display: flex;
  justify-content: center;
  padding-bottom: 40rpx;
}
