.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.from-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-color);
}

.recommend-panel {
  width: 100%;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
  background: var(--card-bg);
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(74,123,247,0.1);
}

.recommend-hint {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.recommend-input {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 41rpx;
  background: #F6F8FF;
  text-align: left;
  font-size: 28rpx;
}

.recommend-submit {
  margin-top: 28rpx;
}

/* 候选列表 */
.candidate-list {
  width: 100%;
  margin-bottom: 30rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.candidate-item.chosen {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
}

.item-emoji {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.item-category {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.check-mark {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 700;
}

/* 结果 */
.result {
  text-align: center;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.result-text {
  display: block;
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.share-result-btn {
  margin: 24rpx auto 0;
  width: 82%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  background: #FFF3E0;
  color: #E67E22;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.share-result-btn::after {
  border: none;
}

/* 底部 */
.footer {
  margin-top: auto;
  display: flex;
  justify-content: center;
  padding-bottom: 40rpx;
}
