.help-choose-page { display: flex; flex-direction: column; }
.coupon-top { margin-bottom: 28rpx; }
.received-panel { text-align: center; }
.received-from { display: inline-block; font-size: 23rpx; color: var(--sage-color); background: var(--sage-light); padding: 7rpx 20rpx; border-radius: 24rpx; }
.help-count { display: block; margin-top: 16rpx; color: var(--primary-color); font-size: 23rpx; }
.received-plate { width: 260rpx; height: 260rpx; margin: 30rpx auto; display: flex; align-items: center; justify-content: center; background: #F1E7D3; border-radius: 50%; border: 14rpx solid #FFFDF7; box-shadow: 0 0 0 1rpx #DDD3C0; }
.received-name { display: block; font-size: 42rpx; line-height: 1.4; font-weight: 750; word-break: break-all; }
.received-description { display: block; font-size: 24rpx; color: var(--text-secondary); margin: 18rpx 0 26rpx; line-height: 1.8; }
.received-msg { padding: 24rpx; margin-bottom: 28rpx; border-left: 4rpx solid #C7B48A; border-radius: 4rpx 16rpx 16rpx 4rpx; background: #F4EEDD; color: #826744; font-family: 'Songti SC', 'Noto Serif CJK SC', serif; font-size: 27rpx; text-align: left; word-break: break-all; }
.author-note { display: block; margin-bottom: 24rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.8; }
.suggestion-wrap { margin-top: 28rpx; }
.suggestion-label { display: block; font-size: 22rpx; color: var(--text-hint); margin-bottom: 14rpx; }
.suggestion-chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.suggestion-chip { padding: 12rpx 18rpx; border: 1rpx solid #DED5C4; background: #F5F0E3; border-radius: 14rpx; font-size: 24rpx; color: var(--text-secondary); max-width: 100%; word-break: break-all; }
.suggestion-chip.active { border-color: var(--primary-color); color: var(--primary-color); background: var(--primary-light); }
.recommend-submit, .share-back-btn { margin-top: 32rpx; }
.recommend-panel .coupon-entry-btn { padding: 20rpx 16rpx; gap: 12rpx; }
.recommend-panel .coupon-entry-icon { width: 50rpx; height: 50rpx; }
.recommend-panel .coupon-entry-title { font-size: 24rpx; }
.recommend-panel .coupon-entry-more { padding: 6rpx 10rpx; }
.recommend-done { text-align: center; padding: 16rpx 0; }
.done-mark { width: 94rpx; height: 94rpx; line-height: 94rpx; margin: 0 auto 24rpx; border-radius: 50%; background: var(--sage-light); color: var(--sage-color); font-size: 48rpx; }
.done-title { display: block; font-size: 34rpx; font-weight: 700; word-break: break-all; }
.done-tip { display: block; color: var(--text-secondary); font-size: 25rpx; line-height: 1.8; margin-top: 20rpx; }
.redo-link { margin: 14rpx auto 0; }
.candidate-item { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 22rpx; background: var(--card-bg); border: 2rpx solid var(--border-color); border-radius: 26rpx; margin-bottom: 18rpx; }
.candidate-item.chosen { background: #FAEBDD; border-color: var(--primary-color); }
.candidate-art { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; background: #F1EDDF; border-radius: 24rpx; flex-shrink: 0; }
.item-info { flex: 1; min-width: 0; }
.item-name { display: block; font-size: 29rpx; font-weight: 650; word-break: break-all; }
.item-category { display: block; font-size: 22rpx; color: var(--text-hint); margin-top: 8rpx; }
.check-mark { width: 38rpx; height: 38rpx; border: 2rpx solid #CFC6B3; border-radius: 50%; flex-shrink: 0; text-align: center; font-size: 24rpx; line-height: 34rpx; }
.check-mark.checked { border-color: var(--primary-color); background: var(--primary-color); color: #FFF9EE; }
.result { padding: 26rpx 0; }
.result-text { display: block; color: var(--sage-color); font-size: 28rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; word-break: break-all; }
.footer { margin-top: 30rpx; }
