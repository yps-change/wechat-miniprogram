.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.from-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-color);
}

/* 候选列表 */
.candidate-list {
  width: 100%;
  margin-bottom: 30rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.candidate-item.chosen {
  border-color: var(--primary-color);
  background-color: var(--primary-light);
}

.item-emoji {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.item-category {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.check-mark {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 700;
}

/* 结果 */
.result {
  text-align: center;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.result-text {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* 底部 */
.footer {
  margin-top: auto;
  display: flex;
  justify-content: center;
  padding-bottom: 40rpx;
}
