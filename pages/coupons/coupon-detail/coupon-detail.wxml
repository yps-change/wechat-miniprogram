<view class="detail-page">
  <view class="hero" style="background: linear-gradient(135deg, {{platform.accentColor}}, #FFB347);">
    <text class="hero-emoji">{{platform.emoji}}</text>
    <text class="hero-title">{{coupon.title}}</text>
    <text class="hero-subtitle">打开 {{coupon.appName || platform.name}}，粘贴口令即可领取</text>
  </view>

  <view class="coupon-ticket">
    <view class="ticket-tag">限时红包</view>
    <text class="ticket-title">{{coupon.title}}</text>
    <text class="ticket-description">{{coupon.description}}</text>
    <view class="ticket-divider"></view>
    <text class="ticket-hint">复制下面内容，再打开 App 自动识别</text>
    <view class="copy-preview">{{copyText}}</view>
    <button class="copy-button" style="background: {{platform.accentColor}};" bindtap="copyCode">
      📋 {{coupon.actionLabel || '复制口令'}}
    </button>
  </view>

  <view class="steps-card">
    <text class="steps-title">领取步骤</text>
    <view class="step-row">
      <text class="step-number">1</text>
      <text class="step-text">点击“复制口令”</text>
    </view>
    <view class="step-row">
      <text class="step-number">2</text>
      <text class="step-text">打开{{coupon.appName || platform.name}}</text>
    </view>
    <view class="step-row">
      <text class="step-number">3</text>
      <text class="step-text">粘贴到搜索框，等待红包弹窗</text>
    </view>
  </view>

  <text class="safe-tip">提示：能否自动弹出红包取决于平台口令/链接类型及 App 当前版本。</text>
</view>