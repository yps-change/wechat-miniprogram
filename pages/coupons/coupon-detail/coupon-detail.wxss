.detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 26rpx; }
.detail-heading .page-eyebrow { font-size: 18rpx; letter-spacing: 2rpx; }
.detail-platform { font-size: 22rpx; color: var(--text-secondary); }
.hero { overflow: hidden; border: 1rpx solid var(--border-color); border-radius: 26rpx; background: var(--card-bg); }
.hero-poster { padding: 0; }
.hero-image { display: block; width: 100%; }
.hero-text { display: flex; flex-direction: column; align-items: center; padding: 40rpx 28rpx; text-align: center; background: var(--sage-light); }
.hero-ticket { width: 130rpx; height: 130rpx; margin-bottom: 22rpx; transform: rotate(-6deg); }
.hero-title { font-size: 37rpx; font-weight: 750; word-break: break-all; }
.hero-subtitle { margin-top: 16rpx; font-size: 24rpx; color: var(--sage-color); }
.coupon-ticket { position: relative; margin-top: 24rpx; padding: 30rpx 28rpx 36rpx; border: 1rpx solid var(--border-color); border-radius: 26rpx; background: var(--card-bg); }
.ticket-tag { display: inline-block; padding: 6rpx 18rpx; border-radius: 20rpx; color: var(--primary-color); background: var(--primary-light); font-size: 21rpx; }
.ticket-title { display: block; margin-top: 22rpx; font-size: 35rpx; font-weight: 750; line-height: 1.5; word-break: break-all; }
.ticket-description { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.8; color: var(--text-secondary); }
.ticket-divider { margin: 28rpx -28rpx 24rpx; border-top: 2rpx dashed #DDD3BF; }
.ticket-hint { display: block; font-size: 24rpx; line-height: 1.8; color: var(--text-secondary); }
.copy-preview { max-height: 260rpx; overflow-y: auto; margin-top: 22rpx; padding: 22rpx; border-radius: 16rpx; border: 1rpx solid #E1D9C7; background: #F5F0E3; color: #7A694E; font-size: 24rpx; line-height: 1.8; word-break: break-all; }
.copy-button { margin-top: 28rpx; }
