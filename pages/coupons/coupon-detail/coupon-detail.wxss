.detail-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: linear-gradient(180deg, #FFF8EF 0%, #FFF1DF 48%, #F5F7FF 100%);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 34rpx 86rpx;
  color: #FFFFFF;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 12rpx 30rpx rgba(230, 126, 34, 0.2);
}

.hero-poster {
  display: block;
  padding: 0;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 0;
  box-shadow: 0 8rpx 22rpx rgba(174, 112, 48, 0.12);
}

.hero-image {
  display: block;
  width: 100%;
  max-height: 620rpx;
}

.hero-emoji {
  font-size: 76rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  text-align: center;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 25rpx;
  opacity: 0.92;
  text-align: center;
}

.coupon-ticket {
  position: relative;
  margin: 24rpx 30rpx 24rpx;
  padding: 34rpx 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(174, 112, 48, 0.16);
  text-align: center;
}

.ticket-tag {
  display: inline-block;
  padding: 7rpx 18rpx;
  color: #E67E22;
  background: #FFF1DF;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.ticket-title {
  display: block;
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #333333;
}

.ticket-description {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8A776A;
}

.ticket-divider {
  height: 2rpx;
  margin: 26rpx 0 20rpx;
  background: repeating-linear-gradient(90deg, #F0DCC9 0 12rpx, transparent 12rpx 22rpx);
}

.ticket-hint {
  display: block;
  padding: 0 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #777777;
}

.copy-preview {
  max-height: 240rpx;
  overflow-y: auto;
  margin-top: 16rpx;
  padding: 18rpx;
  color: #555555;
  background: #F8F8F8;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
  text-align: left;
}

.copy-button {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 88rpx;
  box-shadow: 0 8rpx 20rpx rgba(230, 126, 34, 0.24);
}

.copy-button::after {
  border: none;
}

.steps-card {
  margin: 0 30rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
}

.steps-title {
  display: block;
  margin-bottom: 20rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.step-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  color: #FFFFFF;
  background: #4A7BF7;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
}

.step-text {
  color: #666666;
  font-size: 26rpx;
}

.safe-tip {
  display: block;
  margin: 24rpx 44rpx 0;
  color: #999999;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}