.coupon-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF9F2 0%, #FFF4E8 48%, #F0F5FF 100%);
}

.coupon-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}

.header-emoji {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #E67E22;
}

.subtitle {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #876F5D;
}

.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,0.86);
  border: 2rpx solid rgba(230,126,34,0.16);
  border-radius: 22rpx;
}

.notice-icon {
  font-size: 27rpx;
  line-height: 1.4;
}

.notice-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.4;
  color: #806F62;
}

.platform-card {
  padding: 18rpx 18rpx 8rpx;
  margin-bottom: 14rpx;
  background: rgba(255,255,255,0.96);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(184,125,68,0.12);
}

.platform-heading {
  display: flex;
  align-items: center;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid #F4EDE6;
}

.platform-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.platform-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.coupon-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed #F2E7DE;
}

.coupon-row:last-child {
  border-bottom: none;
}

.coupon-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.coupon-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #444;
}

.coupon-button {
  flex-shrink: 0;
  width: 140rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0;
  background: #FFF4E8;
  border-radius: 27rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.coupon-button::after {
  border: none;
}

.config-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  gap: 8rpx;
  font-size: 23rpx;
  color: #AA9C91;
}
