.coupon-page {
  min-height: 100vh;
  padding: 48rpx 30rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF9F2 0%, #FFF4E8 48%, #F0F5FF 100%);
}

.coupon-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 34rpx;
}

.header-emoji {
  font-size: 68rpx;
  margin-bottom: 10rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #E67E22;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #876F5D;
}

.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx;
  margin-bottom: 26rpx;
  background: rgba(255,255,255,0.86);
  border: 2rpx solid rgba(230,126,34,0.16);
  border-radius: 22rpx;
}

.notice-icon {
  font-size: 32rpx;
  line-height: 1.5;
}

.notice-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: #806F62;
}

.platform-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: rgba(255,255,255,0.96);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(184,125,68,0.12);
}

.platform-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.platform-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  font-size: 40rpx;
}

.platform-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.platform-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.platform-description {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

.coupon-button {
  flex-shrink: 0;
  width: 174rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0;
  background: #FFF4E8;
  border-radius: 35rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.coupon-button::after {
  border: none;
}

.config-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 46rpx;
  gap: 8rpx;
  font-size: 23rpx;
  color: #AA9C91;
}
