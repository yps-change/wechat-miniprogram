.coupon-heading { position: relative; padding-right: 8rpx; }
.coupon-heading .page-title { position: relative; z-index: 1; }
.heading-ticket { position: absolute; width: 94rpx; height: 94rpx; right: 2rpx; top: -8rpx; transform: rotate(12deg); opacity: .55; }
.notice-card { display: flex; flex-direction: column; gap: 10rpx; padding: 24rpx 26rpx; margin-bottom: 28rpx; background: var(--sage-light); border: 1rpx solid #DCE2D0; border-radius: 24rpx; }
.notice-label { font-size: 24rpx; font-weight: 650; color: var(--sage-color); }
.notice-text { font-size: 22rpx; line-height: 1.8; color: #657258; }
.platform-card { padding: 26rpx; margin-bottom: 26rpx; border: 1rpx solid var(--border-color); border-radius: 28rpx; background: var(--card-bg); }
.platform-heading { display: flex; align-items: center; gap: 16rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--border-color); }
.platform-logo { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 16rpx; font-size: 29rpx; flex-shrink: 0; }
.platform-name { font-size: 30rpx; font-weight: 700; flex: 1; min-width: 0; }
.platform-count { font-size: 21rpx; color: var(--text-hint); flex-shrink: 0; }
.coupon-row { position: relative; display: flex; align-items: center; gap: 16rpx; padding: 28rpx 0; border-bottom: 1rpx dashed #DED4C0; }
.coupon-row:last-child { border: 0; padding-bottom: 8rpx; }
.coupon-info { flex: 1; min-width: 0; }
.coupon-title { display: block; font-size: 27rpx; font-weight: 600; word-break: break-all; }
.coupon-subtitle { display: block; margin-top: 8rpx; color: var(--text-hint); font-size: 21rpx; }
.coupon-button.coupon-button { width: auto; margin: 0; min-height: 68rpx; line-height: 1.5; padding: 17rpx 20rpx; border-radius: 17rpx; background: var(--primary-light); color: var(--primary-color); font-size: 23rpx; font-weight: 600; flex-shrink: 0; }
