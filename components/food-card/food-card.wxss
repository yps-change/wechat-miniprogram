:host { display: block; width: 100%; }
.card-container { perspective: 1000px; width: 100%; height: 590rpx; }
.card-inner { position: relative; width: 100%; height: 100%; transition: transform .6s ease-in-out; transform-style: preserve-3d; }
.card-inner.flipped { transform: rotateY(180deg); }
.card-face { position: absolute; width: 100%; height: 100%; box-sizing: border-box; padding: 30rpx; backface-visibility: hidden; -webkit-backface-visibility: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #E0D8C8; border-radius: 30rpx; background: #FFFDF7; color: #302F26; box-shadow: 0 12rpx 28rpx rgba(93, 76, 49, .06); }
.card-front { z-index: 2; background: #F0EDDE; }
.card-back { transform: rotateY(180deg); }
.front-kicker { color: #6D7B5E; font-size: 18rpx; letter-spacing: 3rpx; text-align: center; }
.front-plate, .back-plate { position: relative; display: flex; align-items: center; justify-content: center; width: 248rpx; height: 248rpx; margin: 30rpx 0; border: 14rpx solid #FFFDF7; border-radius: 50%; background: #E6E6D4; box-shadow: 0 0 0 1rpx #D9D0BF; box-sizing: border-box; }
.front-icon { width: 106rpx; height: 106rpx; opacity: .6; }
.front-question { position: absolute; top: 22rpx; right: 26rpx; color: #BD4828; font-family: Georgia, serif; font-size: 42rpx; font-style: italic; }
.front-text { font-size: 36rpx; font-weight: 700; }
.front-hint { color: #817B6E; font-size: 24rpx; margin-top: 16rpx; }
.back-plate { background: #F1E6D3; width: 228rpx; height: 228rpx; margin: 22rpx 0; }
.back-name { width: 100%; font-size: 38rpx; font-weight: 750; text-align: center; word-break: break-all; line-height: 1.4; }
.back-info { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 18rpx; margin-top: 16rpx; }
.back-category { font-size: 23rpx; color: #53694D; background: #ECF0E3; padding: 5rpx 16rpx; border-radius: 20rpx; }
.back-price { font-size: 27rpx; color: #BD4828; font-weight: 600; }
.back-tags { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: center; margin-top: 16rpx; }
.tag { color: #817B6E; font-size: 21rpx; background: #F3EEE3; border-radius: 12rpx; padding: 4rpx 14rpx; }
@media (prefers-reduced-motion: reduce) { .card-inner { transition: none; } }
