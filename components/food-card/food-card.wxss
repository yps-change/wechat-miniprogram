.card-container {
  perspective: 1000px;
  width: 580rpx;
  height: 680rpx;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s ease-in-out;
  transform-style: preserve-3d;
}

.card-inner.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background-color: var(--card-bg);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-front {
  z-index: 2;
}

.card-back {
  transform: rotateY(180deg);
}

/* 正面样式 */
.front-emoji {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.front-text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.front-hint {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 背面样式 */
.back-emoji {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.back-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.back-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.back-category {
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: var(--primary-light);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.back-price {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.back-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.tag {
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}
