/* 全局样式 */
page {
  --primary-color: #4A7BF7;
  --primary-light: #EBF0FF;
  --primary-gradient: linear-gradient(135deg, #4A7BF7, #6C9BFF);
  --bg-color: #F0F5FF;
  --text-color: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --border-color: #EEEEEE;
  --card-bg: #FFFFFF;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --pink-color: #FF1493;
  --purple-color: #7B68EE;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-color);
  background-color: var(--bg-color);
  box-sizing: border-box;
}

/* 通用工具类 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }

/* 通用按钮样式 */
.btn-primary {
  background: var(--primary-gradient);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 6rpx 20rpx rgba(74,123,247,0.3);
}

.btn-primary::after { border: none; }

.btn-secondary {
  background-color: var(--primary-light);
  color: var(--primary-color);
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
}

.btn-secondary::after { border: none; }
