.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 12rpx 24rpx calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #FFFDF7;
  border-top: 1rpx solid #E8E2D5;
}
.tab-bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tab-icon-wrap { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 54rpx; border-radius: 20rpx; }
.active .tab-icon-wrap { background: #F8E6D7; }
.tab-bar-icon { width: 44rpx; height: 44rpx; }
.tab-bar-text { margin-top: 5rpx; font-size: 22rpx; line-height: 1.5; font-weight: 500; }
.active .tab-bar-text { font-weight: 700; }
