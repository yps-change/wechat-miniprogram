.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
  /* 适配 iPhone 底部安全区 */
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}

/* 原生图标约 54rpx、文字约 20rpx，这里比原生略大一点 */
.tab-bar-icon {
  width: 56rpx;
  height: 56rpx;
}

.tab-bar-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.tab-bar-item.active .tab-bar-text {
  font-weight: 700;
}
